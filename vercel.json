{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://mohammadumar.site/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api/check-github).*)",
      "destination": "https://mohammadumar.site/:path*",
      "statusCode": 301
    }
  ]
}
